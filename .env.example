# Copy this file to ".env" to override defaults. All values are optional.

# "sentence-transformers" (default, semantic, needs a one-time model download)
# or "hashing" (offline lexical fallback, no download, lower quality)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Submission limits
MAX_FILE_SIZE_KB=512
JAVAC_TIMEOUT_SECONDS=30
