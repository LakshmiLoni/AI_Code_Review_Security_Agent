# Google Gemini API configuration
# Leave empty to run in rule-based offline mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Flask Session Security Key
SECRET_KEY=replace-with-a-random-secret-key

# Source Code Retention (false = store evidence only; true = retain full code)
RETAIN_SOURCE_CODE=false

# Concurrency
MAX_WORKERS=4

# Vector DB & Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
TOP_K_RETRIEVAL=4
